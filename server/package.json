{
  "name": "campusflow-server",
  "version": "1.0.0",
  "description": "Backend API for CampusFlow",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "seed:academic": "node --env-file-if-exists=.env src/scripts/seed-academic.js",
    "admin:grant": "node --env-file-if-exists=.env src/scripts/create-admin.js",
    "cleanup:files": "node --env-file-if-exists=.env src/scripts/cleanup-files.js",
    "preview:fixture": "node src/scripts/preview-fixture.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
